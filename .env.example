# Required for PostgreSQL. Use a pooled, TLS-enabled connection in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/igp?schema=public"

# Generate a long random secret (at least 32 characters). Sessions are signed, not encrypted.
AUTH_SECRET="replace-with-a-long-random-secret"
# Public, canonical application origin. Required for metadata, redirects and CSRF origin validation.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# The public WhatsApp number is maintained alongside other contact details in lib/contact.ts.

# Initial administrator. Used only by `npm run db:seed`; existing users are not modified.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Optional. Enables secure image/reference-file storage through Vercel Blob.
# BLOB_READ_WRITE_TOKEN=""

# Optional. Configure when notification delivery is implemented.
# EMAIL_PROVIDER_KEY=""
# EMAIL_FROM=""
