# Required for PostgreSQL. Use a pooled, TLS-enabled connection in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/igp?schema=public"

# Generate at least 32 random bytes. Used to sign encrypted HTTP-only sessions.
AUTH_SECRET="replace-with-a-long-random-secret"
# Public, canonical application origin. Required for metadata, redirects and CSRF origin validation.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Initial administrator. Used only by `npm run db:seed`; change before the first seed.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Optional. Enables secure image/reference-file storage through Vercel Blob.
# BLOB_READ_WRITE_TOKEN=""

# Optional. Configure when notification delivery is implemented.
# EMAIL_PROVIDER_KEY=""
# EMAIL_FROM=""
